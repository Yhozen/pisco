# SPDX-License-Identifier: GPL-2.0-or-later
# The Linux title's kernel configuration (docs/linux.md): what tools/build-linux.sh sets on top of the kernel's own
# `tinyconfig`. The build fails if the kernel does not take a line as written.
#
# A kernel that is lifted ahead of time must rewrite its own code as little as possible. One CPU: no LOCK
# prefixes to patch out. No jump labels, no mitigations, no branch tracking: branches are tests, calls and returns
# are plain. No modules, tracing or JITs: no code appears at run time. What is left (alternatives, static calls)
# is listed in tables the lifter reads.
CONFIG_64BIT=y
CONFIG_EXPERT=y
# CONFIG_SMP is not set
CONFIG_PREEMPT_NONE=y
# CONFIG_PREEMPT_DYNAMIC is not set
# CONFIG_JUMP_LABEL is not set
# CONFIG_CPU_MITIGATIONS is not set
# CONFIG_X86_KERNEL_IBT is not set
# CONFIG_MODULES is not set
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_BPF_JIT is not set
# CONFIG_PARAVIRT is not set
# CONFIG_HYPERVISOR_GUEST is not set
# The image stays where it is linked, and only 64-bit programs run.
# CONFIG_RELOCATABLE is not set
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_IA32_EMULATION is not set
# CONFIG_X86_VSYSCALL_EMULATION is not set
# CONFIG_AMD_MEM_ENCRYPT is not set
# The machine (rt/microvm-x64): a local APIC and an IOAPIC found through an MP table, a 16550, a CMOS clock.
# (A 64-bit kernel always has its HPET and microcode code: no HPET is found without ACPI, and the command line
# turns the microcode loader off.)
CONFIG_X86_MPPARSE=y
# CONFIG_ACPI is not set
# CONFIG_PCI is not set
# CONFIG_DMI is not set
# CONFIG_X86_MCE is not set
# CONFIG_VT is not set
CONFIG_PROCESSOR_SELECT=y
CONFIG_CPU_SUP_INTEL=y
# CONFIG_CPU_SUP_AMD is not set
# CONFIG_CPU_SUP_HYGON is not set
# CONFIG_CPU_SUP_CENTAUR is not set
# CONFIG_CPU_SUP_ZHAOXIN is not set
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_DEVPORT=y
# What a small user space needs.
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
# CONFIG_PRINTK_TIME is not set
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_BLK_DEV_INITRD=y
# CONFIG_RD_GZIP is not set
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_FILE_LOCKING=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_UNIX98_PTYS=y
# Compiled as a distribution's kernel is, with frame pointers: a stack is read without tables.
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_UNWINDER_FRAME_POINTER=y
