diff --git a/internal/supervisor/pisco.go b/internal/supervisor/pisco.go
new file mode 100644
index 0000000..5c64fc0
--- /dev/null
+++ b/internal/supervisor/pisco.go
@@ -0,0 +1,194 @@
+package supervisor
+
+// PISCO: an amd64 image's programs run as lifted wasm, ahead-of-time
+// translations of their x86-64 code, as ordinary tasks of the guest's
+// kernel (page/pisco.js). The page asks here for the translations:
+//
+//	pisco/index.json        the programs this image's containers have
+//	                        run before, by the sha256 of each program's
+//	                        image, so the page compiles them while the
+//	                        kernel boots
+//	pisco/lifted/<sha>.wasm one of them
+//	pisco/lift?sha=&fns=    POST: a program met for the first time, its
+//	                        image as the body. Lifted here, on the host
+//	                        (TABC_PISCO_LIFT, the lifter and wasi-sdk),
+//	                        once: kept by its sha256 for every image
+//	pisco/<file>            PISCO's runtime and loader, from the share
+//
+// Lifting runs on the host because the host has the compiler; the
+// page then runs only compiled code, as it runs the kernel.
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/exec"
+
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+)
+
+type piscoServer struct {
+	dir   string // the cache: lifted/<sha>.wasm, images/<key>.json
+	key   string // this image: the hash of its layers' names
+	lift  string // the script that lifts one program
+	logf  func(string, ...any)
+	mu    sync.Mutex
+	share func(w http.ResponseWriter, r *http.Request, name string)
+}
+
+var shaPattern = regexp.MustCompile(`^[0-9a-f]{64}$`)
+var fnsPattern = regexp.MustCompile(`^[0-9a-f,]*$`)
+
+func newPisco(layers []string, logf func(string, ...any), share func(http.ResponseWriter, *http.Request, string)) *piscoServer {
+	base, err := os.UserCacheDir()
+	if err != nil {
+		base = os.TempDir()
+	}
+	h := sha256.Sum256([]byte(strings.Join(layers, "\n")))
+	return &piscoServer{
+		dir:   filepath.Join(base, "tabc", "pisco"),
+		key:   hex.EncodeToString(h[:16]),
+		lift:  os.Getenv("TABC_PISCO_LIFT"),
+		logf:  logf,
+		share: share,
+	}
+}
+
+func (p *piscoServer) record() string { return filepath.Join(p.dir, "images", p.key+".json") }
+func (p *piscoServer) module(sha string) string {
+	return filepath.Join(p.dir, "lifted", sha+".wasm")
+}
+
+// remember adds a program to this image's list.
+func (p *piscoServer) remember(sha string) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	known := map[string]bool{}
+	if data, err := os.ReadFile(p.record()); err == nil {
+		var list []string
+		if json.Unmarshal(data, &list) == nil {
+			for _, s := range list {
+				known[s] = true
+			}
+		}
+	}
+	if known[sha] {
+		return
+	}
+	known[sha] = true
+	list := make([]string, 0, len(known))
+	for s := range known {
+		list = append(list, s)
+	}
+	sort.Strings(list)
+	data, _ := json.Marshal(list)
+	os.MkdirAll(filepath.Dir(p.record()), 0o755)
+	os.WriteFile(p.record(), data, 0o644)
+}
+
+func (p *piscoServer) serve(w http.ResponseWriter, r *http.Request, rest string) {
+	switch {
+	case rest == "index.json":
+		index := map[string]string{}
+		if data, err := os.ReadFile(p.record()); err == nil {
+			var list []string
+			json.Unmarshal(data, &list)
+			for _, sha := range list {
+				if _, err := os.Stat(p.module(sha)); err == nil {
+					index[sha] = sha + ".wasm"
+				}
+			}
+		}
+		writeJSON(w, index)
+	case strings.HasPrefix(rest, "lifted/"):
+		sha := strings.TrimSuffix(strings.TrimPrefix(rest, "lifted/"), ".wasm")
+		if !shaPattern.MatchString(sha) {
+			http.NotFound(w, r)
+			return
+		}
+		w.Header().Set("Content-Type", "application/wasm")
+		http.ServeFile(w, r, p.module(sha))
+	case rest == "lift" && r.Method == http.MethodPost:
+		p.serveLift(w, r)
+	default:
+		p.share(w, r, rest)
+	}
+}
+
+func (p *piscoServer) serveLift(w http.ResponseWriter, r *http.Request) {
+	sha, fns := r.URL.Query().Get("sha"), r.URL.Query().Get("fns")
+	if !shaPattern.MatchString(sha) || !fnsPattern.MatchString(fns) {
+		http.Error(w, "bad request", http.StatusBadRequest)
+		return
+	}
+	image, err := io.ReadAll(io.LimitReader(r.Body, 256<<20))
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	if got := sha256.Sum256(image); hex.EncodeToString(got[:]) != sha {
+		http.Error(w, "the image is not the one named", http.StatusBadRequest)
+		return
+	}
+	out := p.module(sha)
+	if _, err := os.Stat(out); err != nil {
+		if err := p.liftOne(sha, image, fns, out); err != nil {
+			p.logf("pisco: %v", err)
+			http.Error(w, err.Error(), http.StatusUnprocessableEntity)
+			return
+		}
+	}
+	p.remember(sha)
+	w.Header().Set("Content-Type", "application/wasm")
+	http.ServeFile(w, r, out)
+}
+
+var liftLock sync.Mutex
+
+func (p *piscoServer) liftOne(sha string, image []byte, fns, out string) error {
+	if p.lift == "" {
+		return fmt.Errorf("a program no one has lifted (sha256 %s), and no TABC_PISCO_LIFT to lift it", sha[:16])
+	}
+	liftLock.Lock()
+	defer liftLock.Unlock()
+	if _, err := os.Stat(out); err == nil {
+		return nil
+	}
+	os.MkdirAll(filepath.Dir(out), 0o755)
+	elf := filepath.Join(filepath.Dir(out), sha+".elf")
+	if err := os.WriteFile(elf, image, 0o644); err != nil {
+		return err
+	}
+	defer os.Remove(elf)
+	args := []string{elf, "p_" + sha[:16], out}
+	for _, f := range strings.Split(fns, ",") {
+		if f != "" {
+			args = append(args, f)
+		}
+	}
+	p.logf("pisco: lifting a program met for the first time (%d bytes, sha256 %s)", len(image), sha[:16])
+	start := time.Now()
+	cmd := exec.Command(p.lift, args...)
+	if output, err := cmd.CombinedOutput(); err != nil {
+		return fmt.Errorf("lifting %s: %v: %s", sha[:16], err, lastLines(string(output), 5))
+	}
+	p.logf("pisco: lifted %s in %.1f s", sha[:16], time.Since(start).Seconds())
+	return nil
+}
+
+func lastLines(s string, n int) string {
+	lines := strings.Split(strings.TrimSpace(s), "\n")
+	if len(lines) > n {
+		lines = lines[len(lines)-n:]
+	}
+	return strings.Join(lines, "\n")
+}
