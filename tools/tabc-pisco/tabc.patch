diff --git a/page/pisco.js b/page/pisco.js
new file mode 100644
index 0000000..217562f
--- /dev/null
+++ b/page/pisco.js
@@ -0,0 +1,157 @@
+// PISCO in tabc's guest: an amd64 image's programs run as lifted wasm (PISCO's lifter: x86-64 to C to wasm, ahead
+// of time), as ordinary tasks of the same unkernel kernel, instead of under an emulator.
+//
+// The kernel (unkernel's, as tabc ships it) is patched so that its one entry into user code, kw_run, asks PISCO
+// first: a task whose registers say x86-64 runs on pisco.run, any other on kwemu as before. This module:
+// - lets the kernel's memory grow past its RAM, and gives the kernel its `pisco` imports (a trampoline whose table
+//   is filled once PISCO's runtime is there);
+// - fetches PISCO's runtime (runtime.wasm), the loader (x86load, an aarch64 program run as binfmt_misc's interpreter of
+//   x86-64 files) and the image's lifted programs (a side module each, by the sha256 of the program's image), and
+//   compiles them while the kernel boots;
+// - after boot, instantiates the runtime in the kernel's memory above its RAM and registers x86load.
+// A program is registered when it first runs: the runtime rebuilds its image from memory, and the module of that
+// image's sha256 is instantiated. One no container of this image has run before is lifted by the supervisor, on the
+// host (internal/supervisor/pisco.go), once; it is kept for every image after that.
+
+const BASE = new URL("pisco/", location.href);
+const TOP = 0x50000000;           // the memory may grow to 1.25 GiB: the kernel's RAM, then PISCO's (from 1 GiB)
+const RUNTIME_AT = 0x41000000;    // what the runtime's module needs (its data and heap above 1 GiB)
+
+export const enabled = new URL(location.href).searchParams.get("pisco") !== "0";
+let say = null;
+const log = (m) => { console.log(`[pisco] ${m}`); say?.(`pisco: ${m}`); };
+const t0 = performance.now();
+const ms = () => `${(performance.now() - t0).toFixed(0)} ms`;
+
+const fetchBytes = async (url) => {
+  const r = await fetch(url);
+  if (!r.ok) throw new Error(`${url}: ${r.status}`);
+  return new Uint8Array(await r.arrayBuffer());
+};
+const compile = async (url) => WebAssembly.compile(await fetchBytes(url));
+
+let kmem = null, kex = null, rt = null;
+const ttab = new WebAssembly.Table({ element: "anyfunc", initial: 4 });
+let trampoline = null;
+// everything starts loading now, beside the kernel's own fetch and boot
+export const ready = enabled ? (async () => {
+  const [tramp, runtime, loader, index] = await Promise.all([
+    compile(new URL("tramp.wasm", BASE)), compile(new URL("runtime.wasm", BASE)), fetchBytes(new URL("x86load", BASE)),
+    fetch(new URL("index.json", BASE)).then((r) => (r.ok ? r.json() : {})),
+  ]);
+  trampoline = new WebAssembly.Instance(tramp, { js: { tab: ttab } });
+  const modules = new Map();
+  for (const [sha, file] of Object.entries(index)) modules.set(sha, compile(new URL(`lifted/${file}`, BASE)));
+  log(`runtime and ${modules.size} lifted programs fetching (${ms()})`);
+  return { runtime, loader, modules };
+})() : null;
+
+if (enabled) {
+  const OrigMemory = WebAssembly.Memory;
+  function Memory(desc) {
+    if (!desc.shared && !desc.address && desc.maximum === desc.initial && desc.initial >= 1024) desc = { ...desc, maximum: TOP / 65536 };
+    return new OrigMemory(desc);
+  }
+  Memory.prototype = OrigMemory.prototype;
+  WebAssembly.Memory = Memory;
+  const origInstantiate = WebAssembly.instantiate;
+  WebAssembly.instantiate = async function (m, imports, ...rest) {
+    if (imports && imports.unkernel && imports.env && imports.env.memory && m instanceof WebAssembly.Module &&
+        WebAssembly.Module.imports(m).some((i) => i.module === "pisco")) {
+      await ready;
+      imports = { ...imports, pisco: trampoline.exports };
+      kmem = imports.env.memory;
+      const r = await origInstantiate.call(this, m, imports, ...rest);
+      kex = (r.instance ?? r).exports;
+      return r;
+    }
+    return origInstantiate.call(this, m, imports, ...rest);
+  };
+}
+
+// web/side.mjs, for a memory that is not shared
+function loadSide(module, name) {
+  const ex = rt.exports;
+  const sec = new Uint8Array(WebAssembly.Module.customSections(module, "dylink.0")[0]);
+  const at = { i: 0 };
+  const leb = () => { let v = 0, s = 0, x; do { x = sec[at.i++]; v |= (x & 0x7f) << s; s += 7; } while (x & 0x80); return v >>> 0; };
+  let memSize = 0, memAlign = 0, tableSize = 0;
+  while (at.i < sec.length) { const kind = sec[at.i++], len = leb(), end = at.i + len; if (kind === 1) { memSize = leb(); memAlign = leb(); tableSize = leb(); } at.i = end; }
+  const memBase = memSize ? ex.rt_side_alloc(memSize, 2 ** memAlign) : 0;
+  const table = ex.__indirect_function_table, tableBase = table.length;
+  if (tableSize) table.grow(tableSize);
+  const env = {
+    memory: kmem, __indirect_function_table: table, __stack_pointer: ex.__stack_pointer,
+    __memory_base: new WebAssembly.Global({ value: "i32", mutable: false }, memBase),
+    __table_base: new WebAssembly.Global({ value: "i32", mutable: false }, tableBase),
+  };
+  const got = {}, gotFunc = {};
+  for (const i of WebAssembly.Module.imports(module)) {
+    if (i.module === "env" && i.kind === "function") { if (!ex[i.name]) throw new Error(`${name}: the runtime exports no ${i.name}`); env[i.name] = ex[i.name]; }
+    else if (i.module === "GOT.mem") got[i.name] = new WebAssembly.Global({ value: "i32", mutable: true }, ex[i.name].value);
+    else if (i.module === "GOT.func") { const at = table.length; table.grow(1); table.set(at, ex[i.name]); gotFunc[i.name] = new WebAssembly.Global({ value: "i32", mutable: true }, at); }
+  }
+  const side = new WebAssembly.Instance(module, { env, "GOT.mem": got, "GOT.func": gotFunc });
+  side.exports.__wasm_apply_data_relocs?.();
+  side.exports.__wasm_call_ctors?.();
+  ex.rt_program_register(memBase + side.exports[`${name}_program`].value);
+}
+
+const hex = (buf) => [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, "0")).join("");
+
+// After boot: PISCO's runtime in the kernel's memory, and x86load as the interpreter of x86-64 files. Returns the
+// loader's bytes, for the caller to put where the shell below finds it (registerCommand).
+export async function start(sayTo) {
+  say = sayTo;
+  const { runtime, loader, modules } = await ready;
+  if (!kmem) throw new Error("PISCO: the kernel is not the patched one (no pisco imports)");
+  if (kmem.buffer.byteLength < RUNTIME_AT) kmem.grow((RUNTIME_AT - kmem.buffer.byteLength) / 65536);
+  const dec = new TextDecoder();
+  const str = (p, n) => dec.decode(new Uint8Array(kmem.buffer, p, n).slice());
+  const nowNs = () => BigInt(Math.round((performance.timeOrigin + performance.now()) * 1e6));
+  // a program's module, by its image's sha256: loaded once; a second task that meets it meanwhile waits for it
+  const loading = new Map();
+  const load = async (sha, image, entries) => {
+    let pending = modules.get(sha);
+    if (!pending) {
+      // met for the first time: the supervisor lifts it on the host (once; kept by its sha256)
+      log(`lifting a program met for the first time (${image.length} bytes, sha256 ${sha.slice(0, 16)}): once, on the host`);
+      const t = performance.now();
+      const r = await fetch(new URL(`lift?sha=${sha}&fns=${entries}`, BASE), { method: "POST", body: image });
+      if (!r.ok) { log(`could not lift it: ${await r.text()}`); return 0; }
+      pending = WebAssembly.compile(await r.arrayBuffer());
+      log(`lifted it in ${((performance.now() - t) / 1000).toFixed(1)} s`);
+    }
+    loadSide(await pending, `p_${sha.slice(0, 16)}`);
+    log(`program ${sha.slice(0, 16)} registered (${ms()})`);
+    return 1;
+  };
+  const programImage = new WebAssembly.Suspending(async (addr, len, fns, nfns) => {
+    // (what the runtime hands over is read before the first await: another task may run while this one waits)
+    const image = new Uint8Array(kmem.buffer, addr, len).slice();
