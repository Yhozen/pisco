diff --git a/internal/supervisor/pisco.go b/internal/supervisor/pisco.go
new file mode 100644
index 0000000..87c5175
--- /dev/null
+++ b/internal/supervisor/pisco.go
@@ -0,0 +1,343 @@
+package supervisor
+
+// PISCO: an amd64 image's programs run as lifted wasm, ahead-of-time
+// translations of their x86-64 code, as ordinary tasks of the guest's
+// kernel (page/pisco.js). The page asks here for the translations:
+//
+//	pisco/index.json        the programs this image's containers have
+//	                        run before, by the sha256 of each program's
+//	                        image; those most of them ran are compiled
+//	                        while the kernel boots
+//	pisco/lifted/<sha>.wasm one of them
+//	pisco/lift?sha=&len=    POST: a program met for the first time: its
+//	                        image (len bytes), then the addresses of the
+//	                        functions its dynamic symbols name (u64s, the
+//	                        lifter's entries). Lifted here, on the host
+//	                        (TABC_PISCO_LIFT, the lifter and wasi-sdk),
+//	                        once: kept by its sha256 for every image
+//	pisco/<file>            PISCO's runtime and loader, from the share
+//
+// Lifting runs on the host because the host has the compiler; the
+// page then runs only compiled code, as it runs the kernel.
+
+import (
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"os/exec"
+	"strconv"
+	"syscall"
+
+	"path/filepath"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+)
+
+type piscoServer struct {
+	dir   string // the cache: lifted/<sha>.wasm, images/<key>.json
+	key   string // this image: the hash of its layers' names
+	lift  string // the script that lifts one program
+	tools string // what its lifts depend on besides the image (its --tools)
+	logf  func(string, ...any)
+	mu    sync.Mutex
+	seen  map[string]bool // the programs this container ran
+	share func(w http.ResponseWriter, r *http.Request, name string)
+}
+
+var shaPattern = regexp.MustCompile(`^[0-9a-f]{64}$`)
+
+func newPisco(layers []string, logf func(string, ...any), share func(http.ResponseWriter, *http.Request, string)) *piscoServer {
+	base, err := os.UserCacheDir()
+	if err != nil {
+		base = os.TempDir()
+	}
+	names := make([]string, len(layers)) // (a layer's file is named by its digest: the key is the image's, wherever the cache is)
+	for i, l := range layers {
+		names[i] = filepath.Base(l)
+	}
+	h := sha256.Sum256([]byte(strings.Join(names, "\n")))
+	p := &piscoServer{
+		dir:   filepath.Join(base, "tabc", "pisco"),
+		key:   hex.EncodeToString(h[:16]),
+		lift:  os.Getenv("TABC_PISCO_LIFT"),
+		logf:  logf,
+		share: share,
+	}
+	// another lifter makes other modules: they are kept apart
+	if p.lift != "" {
+		if out, err := exec.Command(p.lift, "--tools").Output(); err == nil {
+			p.tools = strings.TrimSpace(string(out))
+		}
+	}
+	return p
+}
+
+func (p *piscoServer) record() string { return filepath.Join(p.dir, "images", p.key+".json") }
+func (p *piscoServer) module(sha string) string {
+	if p.tools != "" {
+		return filepath.Join(p.dir, "lifted", sha+"-"+p.tools+".wasm")
+	}
+	return filepath.Join(p.dir, "lifted", sha+".wasm")
+}
+
+// imageRecord is what this image's containers ran: how many containers
+// asked for the index, and how many of them ran each program.
+type imageRecord struct {
+	Runs     int            `json:"runs"`
+	Programs map[string]int `json:"programs"`
+}
+
+func (p *piscoServer) load() imageRecord {
+	r := imageRecord{Programs: map[string]int{}}
+	if data, err := os.ReadFile(p.record()); err == nil {
+		json.Unmarshal(data, &r)
+	}
+	if r.Programs == nil {
+		r.Programs = map[string]int{}
+	}
+	return r
+}
+
+func (p *piscoServer) save(r imageRecord) {
+	data, _ := json.Marshal(r)
+	os.MkdirAll(filepath.Dir(p.record()), 0o755)
+	os.WriteFile(p.record(), data, 0o644)
+}
+
+// remember counts a program once for this container.
+func (p *piscoServer) remember(sha string) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.seen == nil {
+		p.seen = map[string]bool{}
+	}
+	if p.seen[sha] {
+		return
+	}
+	p.seen[sha] = true
+	r := p.load()
+	r.Programs[sha]++
+	p.save(r)
+}
+
+func (p *piscoServer) serve(w http.ResponseWriter, r *http.Request, rest string) {
+	switch {
+	case rest == "index.json":
+		// every program this image's containers ran, and whether to compile it
+		// while the kernel boots: those most of them ran (the shell, musl's
+		// loader). The others are compiled when they are first met.
+		p.mu.Lock()
+		r := p.load()
+		runs := r.Runs
+		r.Runs++
+		p.save(r)
+		p.mu.Unlock()
+		type entry struct {
+			File  string `json:"file"`
+			Eager bool   `json:"eager"`
+		}
+		index := map[string]entry{}
+		for sha, n := range r.Programs {
+			if _, err := os.Stat(p.module(sha)); err == nil {
+				index[sha] = entry{filepath.Base(p.module(sha)), 2*n >= runs}
+			}
+		}
+		writeJSON(w, index)
+	case strings.HasPrefix(rest, "lifted/"):
+		sha, _, _ := strings.Cut(strings.TrimSuffix(strings.TrimPrefix(rest, "lifted/"), ".wasm"), "-")
+		if !shaPattern.MatchString(sha) {
+			http.NotFound(w, r)
+			return
+		}
+		w.Header().Set("Content-Type", "application/wasm")
+		http.ServeFile(w, r, p.module(sha))
+	case rest == "lift" && r.Method == http.MethodPost:
+		p.serveLift(w, r)
+	default:
+		p.share(w, r, rest)
+	}
+}
+
+func (p *piscoServer) serveLift(w http.ResponseWriter, r *http.Request) {
+	sha := r.URL.Query().Get("sha")
+	size, err := strconv.Atoi(r.URL.Query().Get("len"))
+	if !shaPattern.MatchString(sha) || err != nil || size < 0 {
+		http.Error(w, "bad request", http.StatusBadRequest)
+		return
+	}
+	body, err := io.ReadAll(io.LimitReader(r.Body, 512<<20))
+	if err != nil || len(body) < size || (len(body)-size)%8 != 0 {
+		http.Error(w, "bad request", http.StatusBadRequest)
+		return
+	}
+	image, entries := body[:size], body[size:]
+	var fns []string
+	for k := 0; k+8 <= len(entries); k += 8 {
+		fns = append(fns, strconv.FormatUint(binary.LittleEndian.Uint64(entries[k:]), 16))
+	}
+	if got := sha256.Sum256(image); hex.EncodeToString(got[:]) != sha {
+		http.Error(w, "the image is not the one named", http.StatusBadRequest)
+		return
+	}
+	out := p.module(sha)
+	if _, err := os.Stat(out); err != nil && r.URL.Query().Get("background") == "1" {
+		// for a later run (PISCO's first tier): queued on disk, lifted by a runner of its own, which outlives
+		// this supervisor; answered at once
+		if err := p.queueLift(sha, image, fns, out); err != nil {
+			p.logf("pisco: %v", err)
+			http.Error(w, err.Error(), http.StatusUnprocessableEntity)
+			return
+		}
+		w.WriteHeader(http.StatusAccepted)
+		return
+	}
+	if _, err := os.Stat(out); err != nil {
+		if err := p.liftOne(sha, image, fns, out, r.URL.Query().Get("urgent") == "1"); err != nil {
+			p.logf("pisco: %v", err)
+			http.Error(w, err.Error(), http.StatusUnprocessableEntity)
+			return
+		}
+	}
+	p.remember(sha)
+	w.Header().Set("Content-Type", "application/wasm")
+	http.ServeFile(w, r, out)
+}
+
+// one lift at a time; one a task waits for (urgent) starts before those lifted for a later run (PISCO's first tier)
+var lifts = struct {
+	sync.Mutex
+	cond          *sync.Cond
+	busy          bool
+	urgentWaiting int
+}{}
+
+func liftAcquire(urgent bool) {
+	lifts.Lock()
+	if lifts.cond == nil {
+		lifts.cond = sync.NewCond(&lifts.Mutex)
+	}
+	if urgent {
+		lifts.urgentWaiting++
+	}
+	for lifts.busy || (!urgent && lifts.urgentWaiting > 0) {
+		lifts.cond.Wait()
+	}
+	if urgent {
+		lifts.urgentWaiting--
+	}
+	lifts.busy = true
+	lifts.Unlock()
+}
+
+func liftRelease() {
+	lifts.Lock()
+	lifts.busy = false
+	lifts.cond.Broadcast()
+	lifts.Unlock()
+}
+
+// liftOne lifts a program on the host, in a session of its own: a lift outlives the container that asked for it
+// (PISCO's first tier runs the program on qemu-user meanwhile, and the next container finds it lifted). One lift at
+// a time per supervisor; a lock file beside the module keeps two supervisors from lifting the same program.
+func (p *piscoServer) liftOne(sha string, image []byte, fns []string, out string, urgent bool) error {
+	if p.lift == "" {
+		return fmt.Errorf("a program no one has lifted (sha256 %s), and no TABC_PISCO_LIFT to lift it", sha[:16])
+	}
+	liftAcquire(urgent)
+	defer liftRelease()
+	if _, err := os.Stat(out); err == nil {
+		return nil
+	}
+	os.MkdirAll(filepath.Dir(out), 0o755)
+	lock := out + ".lifting"
+	if f, err := os.OpenFile(lock, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o644); err == nil {
+		f.Close()
+		elf := filepath.Join(filepath.Dir(out), sha+".elf")
+		if err := os.WriteFile(elf, image, 0o644); err != nil {
+			os.Remove(lock)
+			return err
+		}
+		args := []string{"-c", `"$0" "$@" > "$1.log" 2>&1 && mv "$3.tmp" "$3"; rm -f "$1" "$3.lifting"`, p.lift, elf, "p_" + sha[:16], out + ".tmp"}
+		args = append(args, fns...)
+		// ($3 above is the module without .tmp: the script is given out.tmp, and the lock is out.lifting)
+		args[1] = `"$0" "$@" > "$1.log" 2>&1 && mv "$3" "${3%.tmp}"; rm -f "$1" "${3%.tmp}.lifting"`
+		p.logf("pisco: lifting a program met for the first time (%d bytes, sha256 %s)", len(image), sha[:16])
+		cmd := exec.Command("/bin/sh", args...)
+		cmd.SysProcAttr = &syscall.SysProcAttr{Setsid: true}
+		if err := cmd.Start(); err != nil {
+			os.Remove(lock)
+			return err
+		}
+		go cmd.Wait()
+	}
+	start := time.Now()
+	for {
+		if _, err := os.Stat(out); err == nil {
+			p.logf("pisco: lifted %s in %.1f s", sha[:16], time.Since(start).Seconds())
+			return nil
+		}
+		if _, err := os.Stat(lock); err != nil {
+			log, _ := os.ReadFile(filepath.Join(filepath.Dir(out), sha+".elf.log"))
+			return fmt.Errorf("lifting %s failed: %s", sha[:16], lastLines(string(log), 5))
+		}
+		time.Sleep(200 * time.Millisecond)
+	}
+}
+
+// liftQueueRunner lifts what is queued in a module directory ($1), oldest first, with the lift command ($2), one
+// at a time (flock: one runner per directory), until the queue is empty. A module being lifted for a waiting task
+// (liftOne's lock file) is skipped. Started in a session of its own: it outlives the supervisor that queued.
+const liftQueueRunner = `D=$1 L=$2
+exec 9>"$D/queue.lock"; flock -n 9 || exit 0
+while :; do
+  q=$(ls -tr "$D"/*.queued 2>/dev/null | head -n1); [ -n "$q" ] || exit 0
+  out=$(cat "$q"); base=${q%.queued}
+  if [ ! -e "$out" ] && (set -C; : > "$out.lifting") 2>/dev/null; then
+    "$L" "$base.qelf" "$(cat "$base.qname")" "$out.tmp" $(cat "$base.qfns") > "$base.qelf.log" 2>&1 && mv "$out.tmp" "$out"
+    rm -f "$out.lifting" "$out.tmp"
+  fi
+  rm -f "$q" "$base.qelf" "$base.qfns" "$base.qname"
+done`
+
+func (p *piscoServer) queueLift(sha string, image []byte, fns []string, out string) error {
+	if p.lift == "" {
+		return fmt.Errorf("a program no one has lifted (sha256 %s), and no TABC_PISCO_LIFT to lift it", sha[:16])
+	}
+	dir := filepath.Dir(out)
+	os.MkdirAll(dir, 0o755)
+	base := filepath.Join(dir, sha)
+	if _, err := os.Stat(base + ".queued"); err != nil {
+		if err := os.WriteFile(base+".qelf", image, 0o644); err != nil {
+			return err
+		}
+		os.WriteFile(base+".qfns", []byte(strings.Join(fns, " ")), 0o644)
+		os.WriteFile(base+".qname", []byte("p_"+sha[:16]), 0o644)
+		if err := os.WriteFile(base+".queued", []byte(out), 0o644); err != nil {
+			return err
+		}
+		p.logf("pisco: queued %s (%d bytes) to be lifted in the background", sha[:16], len(image))
+	}
+	cmd := exec.Command("/bin/sh", "-c", liftQueueRunner, "lift-queue", dir, p.lift)
+	cmd.Dir = dir
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setsid: true}
+	if err := cmd.Start(); err != nil {
+		return err
+	}
+	go cmd.Wait()
+	return nil
+}
+
+func lastLines(s string, n int) string {
+	lines := strings.Split(strings.TrimSpace(s), "\n")
+	if len(lines) > n {
+		lines = lines[len(lines)-n:]
+	}
+	return strings.Join(lines, "\n")
+}
