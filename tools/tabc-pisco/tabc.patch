+// PISCO (page/pisco.js): when the page put x86load beside init, every x86-64
+// ELF file, static or position-independent, runs through it, as lifted code.
+// F: the interpreter is opened now, so it is found inside the container's
+// root too; P: the program's argv[0] is kept (busybox's applets).
+const x86Loader = "/tabc/bin/x86load"
+
+func registerX86() {
+	if _, err := os.Stat(x86Loader); err != nil {
+		return
+	}
+	// Without randomisation, a library musl's loader maps is at the same
+	// address on every run, so its image, and its lifted module, is the same.
+	os.WriteFile("/proc/sys/kernel/randomize_va_space", []byte("0"), 0)
+	// and maps bottom up, from the guest's TASK_UNMAPPED_BASE: below 2^47, where
+	// x86-64 code may be (the guest's top-down layout starts near 2^48)
+	os.WriteFile("/proc/sys/vm/legacy_va_layout", []byte("1"), 0)
+	const binfmt = "/proc/sys/fs/binfmt_misc"
+	if _, err := os.Stat(binfmt + "/register"); err != nil {
+		syscall.Mount("none", binfmt, "binfmt_misc", 0, "")
+	}
+	if _, err := os.Stat(binfmt + "/x86_64"); err == nil {
+		return
+	}
+	entry := `:x86_64:M::\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x3e\x00:` +
+		`\xff\xff\xff\xff\xff\xfe\xfe\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff:` + x86Loader + `:PF`
+	os.WriteFile(binfmt+"/register", []byte(entry), 0)
+}
